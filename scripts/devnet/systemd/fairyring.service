[Unit]
Description=FairyRing Blockchain Node
After=network.target

[Service]
Type=simple
User=mani
ExecStart=fairyringd start --log_level info --log_format json --home /Users/mani/fairyring/devnet_data/fairyring_devnet --pruning=nothing --grpc.address=0.0.0.0:9090
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
